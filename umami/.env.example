# Umami Configuration
# Copy this to .env and fill in your values

# Generate a random 32-char string for APP_SECRET
# Example: openssl rand -base64 32
APP_SECRET=your_random_32_char_secret_here

# Database password
POSTGRES_PASSWORD=umami_secret_password

# The domain where Umami will be hosted
UMAMI_SITE_URL=https://your-umami-domain.example.com

# The website ID from Umami dashboard (32-char UUID)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The Umami instance URL (for script embedding)
NEXT_PUBLIC_UMAMI_URL=https://your-umami-domain.example.com
